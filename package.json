{
  "name": "dsh-model-picker",
  "description": "Enhanced model picker for the dsh web GUI: search-first model popup + separate reasoning-effort selector, both split on a two-zone trigger button",
  "version": "1.15.0",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "agent-harness",
    "plugin",
    "model",
    "picker",
    "web",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttmouse/dsh-model-picker.git"
  },
  "homepage": "https://github.com/ttmouse/dsh-model-picker",
  "bugs": {
    "url": "https://github.com/ttmouse/dsh-model-picker/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node scripts/interaction.mjs && node scripts/host-route.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}